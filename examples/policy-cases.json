  "identity_and_output_cases": [
    {
      "case_id": "reversed_order",
      "mutation": "Reverse evaluations array",
      "expected": "Map by candidate_id; no action swaps"
    },
    {
      "case_id": "duplicate_id",
      "mutation": "Two evaluations have candidate-001",
      "expected": "Reject ambiguous duplicate members"
    },
    {
      "case_id": "unknown_id",
      "mutation": "An evaluation uses candidate-999",
      "expected": "Reject unknown member"
    },
    {
      "case_id": "cross_candidate_quote",
      "mutation": "candidate-002 cites C001-B01",
      "expected": "Reject candidate-002 with EVIDENCE_INVALID"
    },
    {
      "case_id": "modified_quote",
      "mutation": "Quote invents an outcome absent in the cited block",
      "expected": "Reject with EVIDENCE_INVALID"
    },
    {
      "case_id": "forged_action",
      "mutation": "candidate-002 refers action-001-chat_open",
      "expected": "Reject foreign action reference"
    },
    {
      "case_id": "stale_hash",
      "mutation": "Replace a snapshot hash with an older value",
      "expected": "Do not publish current score"
    },
    {
      "case_id": "missing_member",
      "mutation": "Only eight of ten evaluations returned",
      "expected": "Accept validated eight; retry missing two only"
    },
    {
      "case_id": "expired_link",
      "mutation": "Action state expired and refreshing cannot verify identity",
      "expected": "ACTION_EXPIRED or IDENTITY_UNVERIFIED; do not guess target"
    },
    {
      "case_id": "lost_send_response",
      "mutation": "Platform write may have succeeded but response is lost",
      "expected": "OUTCOME_UNKNOWN; no automatic resend"
    },
    {
      "case_id": "lease_fencing",
      "mutation": "Old worker submits after a newer lease is claimed",
      "expected": "LEASE_LOST; current result remains unchanged"
    },
    {
      "case_id": "sensitive_attribute_change",
      "mutation": "Change only raw age, gender, marital or photo attributes",
      "expected": "Blind scoring snapshot and dimensions unchanged"
    }
  ],
  "hash_algorithm": {
    "encoding": "UTF-8",
    "payload_keys": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/evaluation.schema.json",
  "title": "EvaluationEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "jd_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scorer_profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "rating": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "block_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_kind": {
                        "enum": [
                          "resume_claim"
                        ]
                      }
                    },
                    "required": [
                      "block_id",
                      "quote",
                      "evidence_kind"
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 5
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "missing_information": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0,
                  "maxItems": 5
                }
              },
              "required": [
                "criterion_id",
                "rating",
                "evidence_refs",
                "reason",
                "missing_information"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "rating": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "rating"
                    ]
                  },
                  "then": {
                    "properties": {
                      "evidence_refs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 1,
            "maxItems": 8
          },
          "hard_gates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gate_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unknown"
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "block_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_kind": {
                        "enum": [
                          "resume_claim"
                        ]
                      }
                    },
                    "required": [
                      "block_id",
                      "quote",
                      "evidence_kind"
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 5
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "gate_id",
                "status",
                "evidence_refs",
                "reason"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "pass",
                          "fail"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  },
                  "then": {
                    "properties": {
                      "evidence_refs": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 0,
            "maxItems": 8
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "verification_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 3
          },
          "message_draft": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "action_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 3
          },
          "content_flags": {
            "type": "array",
            "items": {
              "enum": [
                "prompt_injection_detected",
                "text_conflict",
                "ocr_uncertain"
              ]
            },
            "minItems": 0,
            "maxItems": 3
          }
        },
        "required": [
          "candidate_id",
          "snapshot_id",
          "snapshot_sha256",
          "criteria",
          "hard_gates",
          "summary",
          "verification_questions",
          "message_draft",
          "action_refs",
          "content_flags"
        ]
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "job_id",
    "jd_version",
    "rubric_version",
    "scorer_profile_version",
    "evaluations"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/job.schema.json",
  "title": "JobProfileV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "jd_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "scorer_profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "jd_text": {
      "type": "string",
      "minLength": 1
    },
    "rubric_status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "0": {
                "type": "string",
                "minLength": 1
              },
              "1": {
                "type": "string",
                "minLength": 1
              },
              "2": {
                "type": "string",
                "minLength": 1
              },
              "3": {
                "type": "string",
                "minLength": 1
              },
              "4": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "0",
              "1",
              "2",
              "3",
              "4"
            ]
          }
        },
        "required": [
          "criterion_id",
          "name",
          "weight",
          "description",
          "anchors"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "hard_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "business_reason": {
            "type": "string",
            "minLength": 1
          },
          "pass_rule": {
            "type": "string",
            "minLength": 1
          },
          "fail_rule": {
            "type": "string",
            "minLength": 1
          },
          "unknown_rule": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "gate_id",
          "name",
          "business_reason",
          "pass_rule",
          "fail_rule",
          "unknown_rule"
        ]
      },
      "minItems": 0,
      "maxItems": 8
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high_priority_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "standard_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "score_formula_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "human_decision_required": {
          "const": true
        }
      },
      "required": [
        "minimum_coverage",
        "high_priority_score",
        "standard_score",
        "score_formula_version",
        "human_decision_required"
      ]
    },
    "scoring_exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "jd_version",
    "rubric_version",
    "scorer_profile_version",
    "is_synthetic",
    "title",
    "jd_text",
    "rubric_status",
    "approved_by",
    "criteria",
    "hard_gates",
    "review_policy",
    "scoring_exclusions"
  ]
}
